# Dev: leave EMPTY. The browser then calls the Vite dev server on its own origin, which proxies
# /api and /ws to the Node server (see vite.config.ts).
# Production (Vercel): set to the API's URL, e.g. https://your-api.onrender.com
VITE_API_URL=
# Optional: only if the WebSocket lives somewhere other than the API.
# VITE_WS_URL=
