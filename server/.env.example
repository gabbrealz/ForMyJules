NODE_ENV=dev
FRONTEND_URL=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=secretpassword

SESSION_SECRET=change-this-to-something-secure

MONGODB_URI=mongodb://admin:secretpassword@localhost:27017/?authSource=admin

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
STORAGE_BUDGET_BYTES=

COOKIE_SAMESITE=none

# Optional: free TURN relay for the multiplayer photobooth (Metered Open Relay). Without these the
# preview uses STUN only, which fails on networks that block peer-to-peer.
# METERED_APP_NAME is the "<app>" in https://<app>.metered.live
METERED_APP_NAME=
METERED_API_KEY=
